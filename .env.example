# OpenBankingSecurityAPI Environment Configuration

PROJECT_NAME="OpenBankingSecurityAPI Simulator"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# SQLite Database
DATABASE_URL="sqlite:///./open_banking_sim.db"

# RSA Cryptographic Key Paths
RSA_PRIVATE_KEY_PATH="./.keys/private_key.pem"
RSA_PUBLIC_KEY_PATH="./.keys/public_key.pem"
RSA_KEY_ID="obs-key-2026-v1"

# JWT Claims
JWT_ISSUER="https://auth.simulator.openbanking.local"
JWT_AUDIENCE="https://api.simulator.openbanking.local"
ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_CODE_EXPIRE_SECONDS=300

# Rate Limiting Defaults (requests per minute)
DEFAULT_PARTNER_RATE_LIMIT=60
DEFAULT_ENDPOINT_RATE_LIMIT=30

# DPoP Replay Proof Max Age (seconds)
DPOP_PROOF_MAX_AGE_SECONDS=60
